{
  "name": "pilot-presale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/dev.ts",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:pages": "node scripts/gen-pages.mjs",
    "type:report": "node scripts/type-report.mjs",
    "check:site": "tsx scripts/check-site.ts",
    "build:demo": "vite build --mode demo",
    "content": "tsx scripts/content-sync.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "hono": "^4.13.5",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@hono/node-server": "^1.14.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
